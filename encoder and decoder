    // Полупрозрачные круги на фоне (декор)
    HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
    HPEN pen1 = CreatePen(PS_SOLID, 1, RGB(30, 40, 70));
    HGDIOBJ op = SelectObject(hdc, pen1);
    for (int i = 0; i < 15; i++) {
        int x = (i * 137) % rc.right;
        int y = (i * 251) % rc.bottom;
        int r = 30 + (i * 17) % 60;
        Ellipse(hdc, x - r, y - r, x + r, y + r);
    }
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(pen1);
}

