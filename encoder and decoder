    L".-", L"-...", L".--", L"--.", L"-..", L".", L"...-",
    L"--..", L"..", L".---", L"-.-", L".-..", L"--", L"-.",
    L"---", L".--.", L".-.", L"...", L"-", L"..-", L"..-.",
    L"....", L"-.-.", L"---.", L"----", L"--.-", L"--.--", L"-.--",
    L"-..-", L"..-..", L"..--", L".-.-"
};

wstring MorseEncode(const wstring& input) {
    wstring out;
    for (wchar_t c : input) {
        if (c == L' ') { out += L"/ "; continue; }
        if (c >= L'a' && c <= L'z') { out += MORSE_EN[c - L'a']; out += L' '; }
        else if (c >= L'A' && c <= L'Z') { out += MORSE_EN[c - L'A']; out += L' '; }
        else if (c >= L'а' && c <= L'я') { out += MORSE_RU[c - L'а']; out += L' '; }
        else if (c >= L'А' && c <= L'Я') { out += MORSE_RU[c - L'А']; out += L' '; }
        else if (c >= L'0' && c <= L'9') {
            static const wchar_t* digits[10] = {
                L"-----", L".----", L"..---", L"...--", L"....-",
                L".....", L"-....", L"--...", L"---..", L"----."
            };
            out += digits[c - L'0'];
            out += L' ';
        }
        else { out += c; out += L' '; }
    }
    return out;
}

wstring MorseDecode(const wstring& input) {
    wstring out, cur;
    auto findMorse = [](const wstring& code) -> wchar_t {
        for (int i = 0; i < 26; i++) if (code == MORSE_EN[i]) return (wchar_t)(L'A' + i);
        for (int i = 0; i < 32; i++) if (code == MORSE_RU[i]) return (wchar_t)(L'А' + i);
        static const wchar_t* digits[10] = {
            L"-----", L".----", L"..---", L"...--", L"....-",
            L".....", L"-....", L"--...", L"---..", L"----."
        };
        for (int i = 0; i < 10; i++) if (code == digits[i]) return (wchar_t)(L'0' + i);
        return 0;
        };
    for (size_t i = 0; i <= input.length(); i++) {
        wchar_t c = (i < input.length()) ? input[i] : L' ';
        if (c == L' ' || c == L'\t' || c == L'\n' || c == L'\r') {
            if (!cur.empty()) {
                wchar_t d = findMorse(cur);
                out += (d != 0) ? d : L'?';
                cur.clear();
            }
        }
        else if (c == L'/') out += L' ';
        else if (c == L'.' || c == L'-') cur += c;
    }
    return out;
}

// ============================================================
// BINARY
// ============================================================
wstring BinaryEncode(const wstring& input) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    wstring out;
    for (size_t i = 0; i < utf8.length(); i++) {
        unsigned char c = (unsigned char)utf8[i];
        for (int b = 7; b >= 0; b--) out += ((c >> b) & 1) ? L'1' : L'0';
        if (i + 1 < utf8.length()) out += L' ';
    }
    return out;
}

wstring BinaryDecode(const wstring& input) {
    wstring clean;
    for (wchar_t c : input) if (c == L'0' || c == L'1') clean += c;
    if (clean.length() % 8 != 0) return L"Error: length must be multiple of 8";
    string bytes;
    for (size_t i = 0; i < clean.length(); i += 8) {
        unsigned char b = 0;
        for (int j = 0; j < 8; j++) b = (unsigned char)((b << 1) | (clean[i + j] == L'1' ? 1 : 0));
        bytes += (char)b;
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"Error UTF-8";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// ASCII
// ============================================================
wstring AsciiEncode(const wstring& input, bool hex) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    wstring out;
    for (size_t i = 0; i < utf8.length(); i++) {
        unsigned char c = (unsigned char)utf8[i];
        wchar_t buf[16];
        if (hex) swprintf(buf, 16, L"%02X", c);
        else swprintf(buf, 16, L"%d", c);
        out += buf;
        if (i + 1 < utf8.length()) out += L' ';
    }
    return out;
}

wstring AsciiDecode(const wstring& input, bool hex) {
    wstringstream ss(input);
    string bytes;
    wstring token;
    while (ss >> token) {
        int val = hex ? (int)wcstol(token.c_str(), nullptr, 16) : _wtoi(token.c_str());
        if (val >= 0 && val <= 255) bytes += (char)val;
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"Error UTF-8";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// REVERSE
// ============================================================
wstring ReverseString(const wstring& input) {
    wstring out = input;
    reverse(out.begin(), out.end());
    return out;
}

// ============================================================
// ENCODE / DECODE
// ============================================================
wstring Encode(const wstring& input, int mode, const wstring& key) {
    switch (mode) {
    case MODE_BASE64:    return Base64Encode(input);
    case MODE_BASE32:    return Base32Encode(input);
    case MODE_BASE16:    return Base16Encode(input);
    case MODE_URL:       return UrlEncode(input);
    case MODE_ROT13:     return RotN(input, 13);
    case MODE_ROTN:      return RotN(input, _wtoi(key.c_str()));
    case MODE_XOR:       return XorCipher(input, key);
    case MODE_CAESAR:    return RotN(input, _wtoi(key.c_str()));
    case MODE_ATBASH:    return Atbash(input);
    case MODE_MORSE:     return MorseEncode(input);
    case MODE_BINARY:    return BinaryEncode(input);
    case MODE_ASCII_DEC: return AsciiEncode(input, false);
    case MODE_ASCII_HEX: return AsciiEncode(input, true);
    case MODE_REVERSE:   return ReverseString(input);
    }
    return L"";
}

wstring Decode(const wstring& input, int mode, const wstring& key) {
    switch (mode) {
    case MODE_BASE64:    return Base64Decode(input);
    case MODE_BASE32:    return Base32Decode(input);
    case MODE_BASE16:    return Base16Decode(input);
    case MODE_URL:       return UrlDecode(input);
    case MODE_ROT13:     return RotN(input, 13);
    case MODE_ROTN:      return RotN(input, -_wtoi(key.c_str()));
    case MODE_XOR:       return XorCipher(input, key);
    case MODE_CAESAR:    return RotN(input, -_wtoi(key.c_str()));
    case MODE_ATBASH:    return Atbash(input);
    case MODE_MORSE:     return MorseDecode(input);
    case MODE_BINARY:    return BinaryDecode(input);
    case MODE_ASCII_DEC: return AsciiDecode(input, false);
    case MODE_ASCII_HEX: return AsciiDecode(input, true);
    case MODE_REVERSE:   return ReverseString(input);
    }
    return L"";
}

