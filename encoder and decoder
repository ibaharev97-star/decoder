    // Метки
    DrawPanelLabels(hdc);
}

// ============================================================
// WINDOW PROC
// ============================================================
LRESULT CALLBACK WindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
    switch (msg) {
    case WM_CREATE:
        return 0;

    case WM_ERASEBKGND: {
        // Рисуем фон окна
        HDC hdc = (HDC)wp;
        RECT rc;
        GetClientRect(hwnd, &rc);
        DrawCustomUI(hdc);
        return 1;
    }

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);

        RECT rc;
        GetClientRect(hwnd, &rc);

        // Двойная буферизация
        HDC memDC = CreateCompatibleDC(hdc);
        HBITMAP memBmp = CreateCompatibleBitmap(hdc, rc.right, rc.bottom);
        HBITMAP oldBmp = (HBITMAP)SelectObject(memDC, memBmp);

        DrawCustomUI(memDC);

        BitBlt(hdc, 0, 0, rc.right, rc.bottom, memDC, 0, 0, SRCCOPY);

        SelectObject(memDC, oldBmp);
        DeleteObject(memBmp);
        DeleteDC(memDC);

        EndPaint(hwnd, &ps);
        return 0;
    }

    case WM_DRAWITEM:
        OnDrawItem((LPDRAWITEMSTRUCT)lp);
        return TRUE;

    case WM_MEASUREITEM:
        OnMeasureItem((LPMEASUREITEMSTRUCT)lp);
        return TRUE;

    case WM_COMMAND: {
        int id = LOWORD(wp);
        int code = HIWORD(wp);

        switch (id) {
        case IDC_BTN_ENCODE:   if (code == BN_CLICKED) OnEncode(); return 0;
        case IDC_BTN_DECODE:   if (code == BN_CLICKED) OnDecode(); return 0;
        case IDC_BTN_CLEAR:    if (code == BN_CLICKED) OnClear(); return 0;
        case IDC_BTN_COPY_OUT: if (code == BN_CLICKED) OnCopyOutput(); return 0;
        case IDC_BTN_PASTE:    if (code == BN_CLICKED) OnPaste(); return 0;
        case IDC_BTN_LOAD:     if (code == BN_CLICKED) OnLoadFile(); return 0;
        case IDC_BTN_SAVE:     if (code == BN_CLICKED) OnSaveFile(); return 0;
        case IDC_BTN_SWAP:     if (code == BN_CLICKED) OnSwap(); return 0;
        case IDC_BTN_OPEN_DIR: if (code == BN_CLICKED) OnOpenDir(); return 0;
        case IDC_BTN_HISTORY_CLR: if (code == BN_CLICKED) OnClearHistory(); return 0;

        case IDC_COMBO_MODE:
            if (code == CBN_SELCHANGE) {
                g_mode = (int)SendMessageW(g_hComboMode, CB_GETCURSEL, 0, 0);
                UpdateInfo();
                // Перерисовать header
                InvalidateRect(hwnd, nullptr, TRUE);
            }
            return 0;

        case IDC_EDIT_INPUT:
            if (code == EN_CHANGE) UpdateInfo();
            return 0;

        case IDC_HISTORY_LIST:
            if (code == LBN_DBLCLK) {
                int sel = (int)SendMessageW(g_hHistoryList, LB_GETCURSEL, 0, 0);
                if (sel >= 0 && sel < (int)g_history.size()) {
                    SetWindowTextW(g_hEditInput, g_history[sel].inputPreview.c_str());
                    SetWindowTextW(g_hEditOutput, g_history[sel].outputPreview.c_str());
                }
            }
            return 0;
        }
        return 0;
    }

    case WM_MOUSEMOVE: {
        g_mouseX = GET_X_LPARAM(lp);
        g_mouseY = GET_Y_LPARAM(lp);

        HWND h;
        RECT rc;

        auto updateHover = [&](HWND btn, bool& flag) {
            GetWindowRect(btn, &rc);
            MapWindowPoints(HWND_DESKTOP, hwnd, (LPPOINT)&rc, 2);
            bool inside = (g_mouseX >= rc.left && g_mouseX < rc.right &&
                g_mouseY >= rc.top && g_mouseY < rc.bottom);
            if (inside != flag) {
                flag = inside;
                InvalidateRect(btn, nullptr, TRUE);
            }
            };

        updateHover(g_hBtnEncode, g_hoverEncode);
        updateHover(g_hBtnDecode, g_hoverDecode);
        updateHover(g_hBtnClear, g_hoverClear);
        updateHover(g_hBtnCopyOut, g_hoverCopy);
        updateHover(g_hBtnPaste, g_hoverPaste);
        updateHover(g_hBtnLoad, g_hoverLoad);
        updateHover(g_hBtnSave, g_hoverSave);
        updateHover(g_hBtnSwap, g_hoverSwap);
        updateHover(g_hBtnOpenDir, g_hoverOpenDir);
        updateHover(g_hBtnHistoryClr, g_hoverHistClr);

        return 0;
    }

    case WM_TIMER: {
        if (wp == 1) {
            DWORD now = GetTickCount();
            float dt = (now - g_lastTick) / 1000.0f;
            g_lastTick = now;
            if (dt > 0.1f) dt = 0.1f;
            g_animTime += dt;

            // Затухание свечения
            if (g_encodeBtnGlow > 0) {
                g_encodeBtnGlow -= dt * 2.0f;
                if (g_encodeBtnGlow < 0) g_encodeBtnGlow = 0;
                InvalidateRect(g_hBtnEncode, nullptr, TRUE);
            }
            if (g_decodeBtnGlow > 0) {
                g_decodeBtnGlow -= dt * 2.0f;
                if (g_decodeBtnGlow < 0) g_decodeBtnGlow = 0;
                InvalidateRect(g_hBtnDecode, nullptr, TRUE);
            }
        }
        return 0;
    }

    case WM_KEYDOWN: {
        if (GetKeyState(VK_CONTROL) & 0x8000) {
            if (wp == 'V') { OnPaste(); return 0; }
            if (wp == 'C') { OnCopyOutput(); return 0; }
            if (wp == 'S') { OnSaveFile(); return 0; }
            if (wp == 'O') { OnLoadFile(); return 0; }
            if (wp == 'L') { OnClear(); return 0; }
        }

        if (wp == VK_F5) { OnEncode(); return 0; }
        if (wp == VK_F6) { OnDecode(); return 0; }

        return 0;
    }

    case WM_CTLCOLORSTATIC: {
        HDC hdc = (HDC)wp;
        HWND h = (HWND)lp;
        SetBkMode(hdc, TRANSPARENT);
        SetTextColor(hdc, COL_TEXT_DIM);
        if (h == g_hStaticInfo) SetTextColor(hdc, COL_TEXT);
        return (LRESULT)GetStockObject(NULL_BRUSH);
    }

    case WM_CTLCOLOREDIT: {
        HDC hdc = (HDC)wp;
        HWND h = (HWND)lp;
        SetBkColor(hdc, COL_EDITOR_BG);
        SetTextColor(hdc, COL_EDITOR_TEXT);
        if (h == g_hEditKey) {
            SetTextColor(hdc, COL_ACCENT_LT);
        }
        if (h == g_hEditOutput) {
            SetTextColor(hdc, COL_WARNING);
        }
        return (LRESULT)CreateSolidBrush(COL_EDITOR_BG);
    }

    case WM_CTLCOLORLISTBOX: {
        HDC hdc = (HDC)wp;
        SetBkColor(hdc, COL_PANEL);
        SetTextColor(hdc, COL_TEXT);
        return (LRESULT)CreateSolidBrush(COL_PANEL);
    }

    case WM_CTLCOLORBTN: {
        // Кнопки owner-drawn — фон не нужен
        return (LRESULT)GetStockObject(NULL_BRUSH);
    }

    case WM_CLOSE:
        DestroyWindow(hwnd);
        return 0;

    case WM_DESTROY: {
        KillTimer(hwnd, 1);
        PostQuitMessage(0);
        return 0;
    }
    }

    return DefWindowProcW(hwnd, msg, wp, lp);
}

// ============================================================
// ИНИЦИАЛИЗАЦИЯ
// ============================================================
void InitApp(HWND hwnd) {
    g_hwnd = hwnd;
    SetupFonts();
    CreateControls(hwnd);
    g_lastTick = GetTickCount();
    SetTimer(hwnd, 1, 30, nullptr);
}

void ShutdownApp() {
    if (g_fontSmall) DeleteObject(g_fontSmall);
    if (g_fontMedium) DeleteObject(g_fontMedium);
    if (g_fontLarge) DeleteObject(g_fontLarge);
    if (g_fontMono) DeleteObject(g_fontMono);
    if (g_fontMonoBold) DeleteObject(g_fontMonoBold);
    if (g_fontBold) DeleteObject(g_fontBold);
    if (g_fontIcon) DeleteObject(g_fontIcon);
}

// ============================================================
// ТОЧКА ВХОДА
// ============================================================
int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE, LPWSTR, int nCmdShow) {
    g_hInst = hInst;

    INITCOMMONCONTROLSEX icc = {};
    icc.dwSize = sizeof(icc);
    icc.dwICC = ICC_WIN95_CLASSES;
    InitCommonControlsEx(&icc);

    WNDCLASSEXW wc = {};
    wc.cbSize = sizeof(wc);
    wc.style = CS_HREDRAW | CS_VREDRAW | CS_DBLCLKS;
    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = nullptr;   // рисуем сами
    wc.lpszClassName = L"CryptoToolUltimateClass";
    wc.hIcon = LoadIcon(nullptr, IDI_APPLICATION);

    if (!RegisterClassExW(&wc)) return 1;

    RECT rc = { 0, 0, WINDOW_W, WINDOW_H };
    AdjustWindowRect(&rc, WS_OVERLAPPEDWINDOW, FALSE);

    HWND hwnd = CreateWindowExW(
        0, L"CryptoToolUltimateClass",
        L"Crypto Tool Ultimate — эстетика шифрования",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT,
        rc.right - rc.left, rc.bottom - rc.top,
        nullptr, nullptr, hInst, nullptr
    );

    if (!hwnd) return 1;

    InitApp(hwnd);

    // Тёмный заголовок окна (Windows 10+)
    BOOL dark = TRUE;
    DwmSetWindowAttribute(hwnd, 20, &dark, sizeof(dark));
    DwmSetWindowAttribute(hwnd, 19, &dark, sizeof(dark));

    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    MSG msg = {};
    while (GetMessageW(&msg, nullptr, 0, 0)) {
        if (!IsDialogMessageW(hwnd, &msg)) {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }

    ShutdownApp();
    return (int)msg.wParam;
}
