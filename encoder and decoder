void AddToHistory(int mode, const wstring& input, const wstring& output, bool isEncode) {
    HistoryEntry e;
    e.time = time(nullptr);
    e.mode = mode;

    wstring in = input;
    wstring out = output;
    if (in.length() > 40) in = in.substr(0, 37) + L"...";
    if (out.length() > 40) out = out.substr(0, 37) + L"...";
    e.inputPreview = in;
    e.outputPreview = out;
    e.isEncode = isEncode;

    g_history.insert(g_history.begin(), e);
    if (g_history.size() > 100) g_history.pop_back();

    RefreshHistoryList();
}

void OnEncode() {
    wstring input = GetInputText();
    if (input.empty()) { SetOutputText(L""); UpdateInfo(); return; }
    wstring result = Encode(input, g_mode, GetKey());
    SetOutputText(result);
    AddToHistory(g_mode, input, result, true);
    UpdateInfo();
    g_encodeBtnGlow = 1.0f;
}

void OnDecode() {
    wstring input = GetInputText();
    if (input.empty()) { SetOutputText(L""); UpdateInfo(); return; }
    wstring result = Decode(input, g_mode, GetKey());
    SetOutputText(result);
    AddToHistory(g_mode, input, result, false);
    UpdateInfo();
    g_decodeBtnGlow = 1.0f;
}

void OnClear() {
    SetWindowTextW(g_hEditInput, L"");
    SetWindowTextW(g_hEditOutput, L"");
    SetWindowTextW(g_hEditKey, L"");
    UpdateInfo();
}

void OnCopyOutput() {
    wstring text = GetOutputText();
    if (text.empty()) text = GetInputText();
    if (text.empty()) return;
    if (OpenClipboard(g_hwnd)) {
        EmptyClipboard();
        size_t len = (text.length() + 1) * sizeof(wchar_t);
        HGLOBAL hMem = GlobalAlloc(GMEM_MOVEABLE, len);
        if (hMem) {
            wchar_t* ptr = (wchar_t*)GlobalLock(hMem);
            if (ptr) {
                wcscpy_s(ptr, text.length() + 1, text.c_str());
                GlobalUnlock(hMem);
                SetClipboardData(CF_UNICODETEXT, hMem);
            }
        }
        CloseClipboard();
    }
}

void OnPaste() {
    if (OpenClipboard(g_hwnd)) {
        HANDLE hData = GetClipboardData(CF_UNICODETEXT);
        if (hData) {
            wchar_t* ptr = (wchar_t*)GlobalLock(hData);
            if (ptr) {
                SetWindowTextW(g_hEditInput, ptr);
                GlobalUnlock(hData);
            }
        }
        CloseClipboard();
        UpdateInfo();
    }
}

void OnLoadFile() {
    EnsureCryptoToolDir();
    wstring path = GetCryptoToolDir() + L"\\input.txt";

    if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) {
        wstring msg = L"Файл не найден:\n" + path;
        MessageBoxW(g_hwnd, msg.c_str(), L"Ошибка", MB_OK | MB_ICONWARNING);
        return;
    }

    HANDLE hFile = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ,
        nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (hFile == INVALID_HANDLE_VALUE) {
        MessageBoxW(g_hwnd, L"Не удалось открыть файл", L"Ошибка", MB_OK | MB_ICONERROR);
        return;
    }

    DWORD size = GetFileSize(hFile, nullptr);
    if (size == 0 || size > 10 * 1024 * 1024) {
        CloseHandle(hFile);
        MessageBoxW(g_hwnd, L"Файл пустой или слишком большой", L"Ошибка", MB_OK);
        return;
    }

    vector<char> buf(size + 1);
    DWORD read = 0;
    ReadFile(hFile, &buf[0], size, &read, nullptr);
    buf[read] = 0;
    CloseHandle(hFile);

    const char* data = &buf[0];
    int dataLen = (int)read;
    if (dataLen >= 3 && (unsigned char)data[0] == 0xEF &&
        (unsigned char)data[1] == 0xBB && (unsigned char)data[2] == 0xBF) {
        data += 3;
        dataLen -= 3;
    }

    int wlen = MultiByteToWideChar(CP_UTF8, 0, data, dataLen, nullptr, 0);
    if (wlen > 0) {
        wstring wbuf(wlen, L'\0');
        MultiByteToWideChar(CP_UTF8, 0, data, dataLen, &wbuf[0], wlen);
        SetWindowTextW(g_hEditInput, wbuf.c_str());
    }
    UpdateInfo();
}

void OnSaveFile() {
    EnsureCryptoToolDir();
    wstring path = GetCryptoToolDir() + L"\\output.txt";

    wstring text = GetOutputText();
    if (text.empty()) text = GetInputText();

    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, text.c_str(), (int)text.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, text.c_str(), (int)text.length(),
            &utf8[0], len, nullptr, nullptr);
    }

    HANDLE hFile = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr,
        CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (hFile == INVALID_HANDLE_VALUE) {
        MessageBoxW(g_hwnd, L"Не удалось создать файл", L"Ошибка", MB_OK | MB_ICONERROR);
        return;
    }

    const unsigned char bom[3] = { 0xEF, 0xBB, 0xBF };
    DWORD written = 0;
    WriteFile(hFile, bom, 3, &written, nullptr);
    if (!utf8.empty()) {
        WriteFile(hFile, utf8.c_str(), (DWORD)utf8.length(), &written, nullptr);
    }
    CloseHandle(hFile);

    wstring msg = L"Файл сохранён:\n" + path;
    MessageBoxW(g_hwnd, msg.c_str(), L"Готово", MB_OK | MB_ICONINFORMATION);
}

void OnSwap() {
    wstring in = GetInputText();
    wstring out = GetOutputText();
    SetWindowTextW(g_hEditInput, out.c_str());
    SetWindowTextW(g_hEditOutput, in.c_str());
    UpdateInfo();
}

void OnOpenDir() {
