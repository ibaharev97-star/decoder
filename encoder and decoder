// ============================================================
// ОТРИСОВКА КНОПОК
// ============================================================
struct ButtonStyle {
    COLORREF fill1, fill2;
    COLORREF border;
    COLORREF text;
    const wchar_t* label;
    int iconSize;
    bool* hoverFlag;
    float* glowPtr;
    COLORREF glowColor;
};

void DrawStyledButton(HDC hdc, RECT rc, const ButtonStyle& style) {
    bool hover = style.hoverFlag ? *style.hoverFlag : false;
    float glow = style.glowPtr ? *style.glowPtr : 0.0f;

    // Тень
    RECT shadowRc = rc;
    shadowRc.left += 2;
    shadowRc.top += 2;
    DrawRoundedRect(hdc, shadowRc, 10, RGB(8, 10, 16), RGB(8, 10, 16));

    // Свечение
    if (glow > 0.01f) {
        int expand = (int)(glow * 12);
        RECT glowRc = rc;
        glowRc.left -= expand;
        glowRc.top -= expand;
        glowRc.right += expand;
        glowRc.bottom += expand;
        DrawRoundedRect(hdc, glowRc, 14, style.glowColor, style.glowColor);
    }

    // Фон градиент
    COLORREF fill1 = style.fill1;
    COLORREF fill2 = style.fill2;
    if (hover) {
        fill1 = RGB(
            min(255, (int)GetRValue(fill1) + 30),
            min(255, (int)GetGValue(fill1) + 30),
            min(255, (int)GetBValue(fill1) + 30));
        fill2 = RGB(
            min(255, (int)GetRValue(fill2) + 30),
            min(255, (int)GetGValue(fill2) + 30),
            min(255, (int)GetBValue(fill2) + 30));
    }

    DrawGradientRect(hdc, rc, fill1, fill2);

    // Верхняя светлая полоса
    RECT topRc = { rc.left + 2, rc.top + 2, rc.right - 2, rc.top + 3 };
    HBRUSH lightBr = CreateSolidBrush(RGB(
        min(255, (int)GetRValue(fill1) + 60),
        min(255, (int)GetGValue(fill1) + 60),
        min(255, (int)GetBValue(fill1) + 60)));
    FillRect(hdc, &topRc, lightBr);
    DeleteObject(lightBr);

    // Рамка
    HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
    HPEN pen = CreatePen(PS_SOLID, 1, style.border);
    HGDIOBJ op = SelectObject(hdc, pen);
    RoundRect(hdc, rc.left, rc.top, rc.right, rc.bottom, 10, 10);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(pen);

    // Текст
    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, style.text);
    HGDIOBJ oldFont = SelectObject(hdc, g_fontBold);
    DrawTextW(hdc, style.label, -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    SelectObject(hdc, oldFont);
}

