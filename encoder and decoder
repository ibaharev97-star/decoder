// BASE64
// ============================================================
static const wchar_t* B64_CHARS = L"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

wstring Base64Encode(const wstring& input) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    wstring out;
    int n = (int)utf8.length(), i = 0;
    while (i < n) {
        int remain = n - i;
        unsigned char b0 = (remain > 0) ? (unsigned char)utf8[i] : 0;
        unsigned char b1 = (remain > 1) ? (unsigned char)utf8[i + 1] : 0;
        unsigned char b2 = (remain > 2) ? (unsigned char)utf8[i + 2] : 0;
        out += B64_CHARS[(b0 >> 2) & 0x3F];
        out += B64_CHARS[((b0 << 4) | (b1 >> 4)) & 0x3F];
        out += (remain > 1) ? B64_CHARS[((b1 << 2) | (b2 >> 6)) & 0x3F] : L'=';
        out += (remain > 2) ? B64_CHARS[b2 & 0x3F] : L'=';
        i += 3;
    }
    return out;
}

wstring Base64Decode(const wstring& input) {
    wstring clean;
    for (wchar_t c : input) {
        if (c == L' ' || c == L'\n' || c == L'\r' || c == L'\t') continue;
        clean += c;
    }
    int table[256];
    for (int i = 0; i < 256; i++) table[i] = -1;
    for (int i = 0; i < 64; i++) table[(unsigned char)B64_CHARS[i]] = i;
    string bytes;
    int n = (int)clean.length(), i = 0;
    while (i < n) {
        int v0 = -1, v1 = -1, v2 = -1, v3 = -1;
        if (i < n && clean[i] != L'=') v0 = table[(unsigned char)clean[i]]; i++;
        if (i < n && clean[i] != L'=') v1 = table[(unsigned char)clean[i]]; i++;
        if (i < n && clean[i] != L'=') v2 = table[(unsigned char)clean[i]]; i++;
        if (i < n && clean[i] != L'=') v3 = table[(unsigned char)clean[i]]; i++;
        if (v0 < 0 || v1 < 0) break;
        bytes += (char)((v0 << 2) | (v1 >> 4));
        if (v2 >= 0) bytes += (char)(((v1 & 0xF) << 4) | (v2 >> 2));
        if (v3 >= 0) bytes += (char)(((v2 & 0x3) << 6) | v3);
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// BASE32
// ============================================================
static const wchar_t* B32_CHARS = L"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";

wstring Base32Encode(const wstring& input) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    wstring out;
    int n = (int)utf8.length(), i = 0;
    while (i < n) {
        int remain = n - i;
        unsigned char b0 = (remain > 0) ? (unsigned char)utf8[i] : 0;
        unsigned char b1 = (remain > 1) ? (unsigned char)utf8[i + 1] : 0;
        unsigned char b2 = (remain > 2) ? (unsigned char)utf8[i + 2] : 0;
        unsigned char b3 = (remain > 3) ? (unsigned char)utf8[i + 3] : 0;
        unsigned char b4 = (remain > 4) ? (unsigned char)utf8[i + 4] : 0;
        out += B32_CHARS[(b0 >> 3) & 0x1F];
        out += B32_CHARS[((b0 << 2) | (b1 >> 6)) & 0x1F];
        out += B32_CHARS[(b1 >> 1) & 0x1F];
        out += B32_CHARS[((b1 << 4) | (b2 >> 4)) & 0x1F];
        out += B32_CHARS[((b2 << 1) | (b3 >> 7)) & 0x1F];
        out += B32_CHARS[(b3 >> 2) & 0x1F];
        out += B32_CHARS[((b3 << 3) | (b4 >> 5)) & 0x1F];
        out += B32_CHARS[b4 & 0x1F];
        i += 5;
    }
    while (out.length() % 8 != 0) out += L'=';
    return out;
}

wstring Base32Decode(const wstring& input) {
    wstring clean;
    for (wchar_t c : input) {
        if (c == L' ' || c == L'\n' || c == L'\r' || c == L'\t' || c == L'=') continue;
        clean += towupper(c);
    }
    int table[256];
    for (int i = 0; i < 256; i++) table[i] = -1;
    for (int i = 0; i < 32; i++) table[(unsigned char)B32_CHARS[i]] = i;
    string bytes;
    int n = (int)clean.length(), i = 0;
    while (i + 1 < n) {
        int vals[8] = { 0 };
        int valid = 0;
        for (int k = 0; k < 8; k++) {
            if (i + k < n) {
                int v = table[(unsigned char)clean[i + k]];
                vals[k] = (v < 0) ? 0 : v;
                valid++;
            }
        }
        i += 8;
        bytes += (char)((vals[0] << 3) | (vals[1] >> 2));
        if (valid > 2) bytes += (char)(((vals[1] & 0x3) << 6) | (vals[2] << 1) | (vals[3] >> 4));
        if (valid > 4) bytes += (char)(((vals[3] & 0xF) << 4) | (vals[4] >> 1));
        if (valid > 5) bytes += (char)(((vals[4] & 0x1) << 7) | (vals[5] << 2) | (vals[6] >> 3));
        if (valid > 7) bytes += (char)(((vals[6] & 0x7) << 5) | vals[7]);
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// BASE16
// ============================================================
wstring Base16Encode(const wstring& input) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    static const wchar_t* hex = L"0123456789ABCDEF";
    wstring out;
    for (size_t i = 0; i < utf8.length(); i++) {
        unsigned char c = (unsigned char)utf8[i];
        out += hex[(c >> 4) & 0xF];
        out += hex[c & 0xF];
        if (i + 1 < utf8.length()) out += L' ';
    }
    return out;
}

wstring Base16Decode(const wstring& input) {
    wstring clean;
    for (wchar_t c : input) if (iswxdigit(c)) clean += c;
    if (clean.length() % 2 != 0) return L"Error: odd hex length";
    auto hexVal = [](wchar_t c) -> int {
        if (c >= L'0' && c <= L'9') return c - L'0';
        if (c >= L'A' && c <= L'F') return c - L'A' + 10;
        if (c >= L'a' && c <= L'f') return c - L'a' + 10;
        return 0;
        };
    string bytes;
    for (size_t i = 0; i < clean.length(); i += 2) {
        bytes += (char)((hexVal(clean[i]) << 4) | hexVal(clean[i + 1]));
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// URL
// ============================================================
static bool IsUrlSafe(wchar_t c) {
    return (c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z') ||
        (c >= L'0' && c <= L'9') || c == L'-' || c == L'_' || c == L'.' || c == L'~';
}

wstring UrlEncode(const wstring& input) {
    string utf8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    static const wchar_t* hex = L"0123456789ABCDEF";
    wstring out;
    for (unsigned char c : utf8) {
        if (IsUrlSafe((wchar_t)c)) out += (wchar_t)c;
        else {
            out += L'%';
            out += hex[(c >> 4) & 0xF];
            out += hex[c & 0xF];
        }
    }
    return out;
}

wstring UrlDecode(const wstring& input) {
    auto hexVal = [](wchar_t c) -> int {
        if (c >= L'0' && c <= L'9') return c - L'0';
        if (c >= L'A' && c <= L'F') return c - L'A' + 10;
        if (c >= L'a' && c <= L'f') return c - L'a' + 10;
        return 0;
        };
    string bytes;
    for (size_t i = 0; i < input.length(); i++) {
        if (input[i] == L'%' && i + 2 < input.length()) {
            bytes += (char)((hexVal(input[i + 1]) << 4) | hexVal(input[i + 2]));
            i += 2;
        }
        else if (input[i] == L'+') bytes += ' ';
        else bytes += (char)input[i];
    }
    if (bytes.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), nullptr, 0);
    if (wlen <= 0) return L"";
    wstring out(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, bytes.c_str(), (int)bytes.length(), &out[0], wlen);
    return out;
}

// ============================================================
// ROT
// ============================================================
wstring RotN(const wstring& input, int n) {
    n = ((n % 26) + 26) % 26;
    wstring out = input;
    for (auto& c : out) {
        if (c >= L'a' && c <= L'z') c = (wchar_t)(L'a' + (c - L'a' + n) % 26);
        else if (c >= L'A' && c <= L'Z') c = (wchar_t)(L'A' + (c - L'A' + n) % 26);
        else if (c >= L'а' && c <= L'я') c = (wchar_t)(L'а' + (c - L'а' + n) % 32);
        else if (c >= L'А' && c <= L'Я') c = (wchar_t)(L'А' + (c - L'А' + n) % 32);
    }
    return out;
}

// ============================================================
// XOR
// ============================================================
wstring XorCipher(const wstring& input, const wstring& key) {
    if (key.empty()) return L"Error: empty key";
    string utf8, keyU8;
    int len = WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        utf8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, input.c_str(), (int)input.length(),
            &utf8[0], len, nullptr, nullptr);
    }
    len = WideCharToMultiByte(CP_UTF8, 0, key.c_str(), (int)key.length(),
        nullptr, 0, nullptr, nullptr);
    if (len > 0) {
        keyU8.resize(len);
        WideCharToMultiByte(CP_UTF8, 0, key.c_str(), (int)key.length(),
            &keyU8[0], len, nullptr, nullptr);
    }
    if (keyU8.empty()) return L"Error: empty key";
    string out(utf8.length(), 0);
    for (size_t i = 0; i < utf8.length(); i++)
        out[i] = (char)((unsigned char)utf8[i] ^ (unsigned char)keyU8[i % keyU8.length()]);
    if (out.empty()) return L"";
    int wlen = MultiByteToWideChar(CP_UTF8, 0, out.c_str(), (int)out.length(), nullptr, 0);
    if (wlen <= 0) {
        static const wchar_t* hex = L"0123456789ABCDEF";
        wstring hexOut;
        for (unsigned char c : out) {
            hexOut += hex[(c >> 4) & 0xF];
            hexOut += hex[c & 0xF];
            hexOut += L' ';
        }
        return hexOut;
    }
    wstring wout(wlen, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, out.c_str(), (int)out.length(), &wout[0], wlen);
    return wout;
}

// ============================================================
// ATBASH
// ============================================================
wstring Atbash(const wstring& input) {
    wstring out = input;
    for (auto& c : out) {
        if (c >= L'a' && c <= L'z') c = (wchar_t)(L'z' - (c - L'a'));
        else if (c >= L'A' && c <= L'Z') c = (wchar_t)(L'Z' - (c - L'A'));
        else if (c >= L'а' && c <= L'я') c = (wchar_t)(L'я' - (c - L'а'));
        else if (c >= L'А' && c <= L'Я') c = (wchar_t)(L'Я' - (c - L'А'));
    }
    return out;
}

