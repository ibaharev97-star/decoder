// ============================================================
void DrawGradientRect(HDC hdc, RECT rc, COLORREF top, COLORREF bottom) {
    int h = rc.bottom - rc.top;
    if (h <= 0) return;
    for (int y = 0; y < h; y++) {
        float t = (float)y / h;
        int r = (int)(GetRValue(top) + (GetRValue(bottom) - GetRValue(top)) * t);
        int g = (int)(GetGValue(top) + (GetGValue(bottom) - GetGValue(top)) * t);
        int b = (int)(GetBValue(top) + (GetBValue(bottom) - GetBValue(top)) * t);
        RECT line = { rc.left, rc.top + y, rc.right, rc.top + y + 1 };
        HBRUSH br = CreateSolidBrush(RGB(r, g, b));
        FillRect(hdc, &line, br);
        DeleteObject(br);
    }
}

void DrawRoundedRect(HDC hdc, RECT rc, int radius, COLORREF fill, COLORREF border) {
    HBRUSH br = CreateSolidBrush(fill);
    HPEN pen = CreatePen(PS_SOLID, 1, border);
    HGDIOBJ ob = SelectObject(hdc, br);
    HGDIOBJ op = SelectObject(hdc, pen);
    RoundRect(hdc, rc.left, rc.top, rc.right, rc.bottom, radius, radius);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(br);
    DeleteObject(pen);
}

void DrawGlowText(HDC hdc, RECT rc, const wstring& text, COLORREF color,
    COLORREF glow, HFONT font, UINT fmt) {
    SetBkMode(hdc, TRANSPARENT);
    HGDIOBJ oldFont = SelectObject(hdc, font);

    // Свечение — несколько смещённых копий
    SetTextColor(hdc, glow);
    RECT r;
    r = rc; r.left -= 1; r.top -= 1;
    DrawTextW(hdc, text.c_str(), -1, &r, fmt);
    r = rc; r.left += 1; r.top -= 1;
    DrawTextW(hdc, text.c_str(), -1, &r, fmt);
    r = rc; r.left -= 1; r.top += 1;
    DrawTextW(hdc, text.c_str(), -1, &r, fmt);
    r = rc; r.left += 1; r.top += 1;
    DrawTextW(hdc, text.c_str(), -1, &r, fmt);

    // Основной текст
    SetTextColor(hdc, color);
    DrawTextW(hdc, text.c_str(), -1, &rc, fmt);

    SelectObject(hdc, oldFont);
}

