// ============================================================
// Отрисовка строки истории
// ============================================================
void OnDrawHistoryItem(LPDRAWITEMSTRUCT dis) {
    HDC hdc = dis->hDC;
    RECT rc = dis->rcItem;

    bool selected = (dis->itemState & ODS_SELECTED) != 0;

    if (dis->itemID == (UINT)-1) return;

    // Фон
    COLORREF bg = selected ? COL_ACCENT_DK :
        (dis->itemID % 2 == 0) ? COL_PANEL : COL_BG2;
    HBRUSH bgBr = CreateSolidBrush(bg);
    FillRect(hdc, &rc, bgBr);
    DeleteObject(bgBr);

    // Границы
    HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
    HPEN pen = CreatePen(PS_SOLID, 1, COL_BORDER);
    HGDIOBJ op = SelectObject(hdc, pen);
    Rectangle(hdc, rc.left, rc.top, rc.right, rc.bottom);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(pen);

    // Получаем данные
    int idx = (int)dis->itemID;
    if (idx < 0 || idx >= (int)g_history.size()) return;

    const HistoryEntry& e = g_history[idx];

    // Иконка типа
    tm ti;
    localtime_s(&ti, &e.time);

    wchar_t typeBuf[8];
    wcscpy_s(typeBuf, e.isEncode ? L"EN" : L"DE");

    RECT typeRc = { rc.left + 8, rc.top + 4, rc.left + 46, rc.bottom - 4 };
    COLORREF typeCol = e.isEncode ? COL_SUCCESS : COL_INFO;

    // Скруглённая "пилюля" для типа
    HBRUSH typeBr = CreateSolidBrush(typeCol);
    HPEN typePen = CreatePen(PS_NULL, 0, typeCol);
    HGDIOBJ ob2 = SelectObject(hdc, typeBr);
    HGDIOBJ op2 = SelectObject(hdc, typePen);
    RoundRect(hdc, typeRc.left, typeRc.top, typeRc.right, typeRc.bottom, 8, 8);
    SelectObject(hdc, ob2);
    SelectObject(hdc, op2);
    DeleteObject(typeBr);
    DeleteObject(typePen);

    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, RGB(20, 30, 20));
    HGDIOBJ oldFont = SelectObject(hdc, g_fontBold);
    DrawTextW(hdc, typeBuf, -1, &typeRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    // Название режима
    RECT modeRc = { rc.left + 56, rc.top, rc.left + 200, rc.bottom };
    SetTextColor(hdc, COL_ACCENT_LT);
    SelectObject(hdc, g_fontMonoBold);
    DrawTextW(hdc, g_modes[e.mode].name, -1, &modeRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

    // Время
    wchar_t timeBuf[32];
    swprintf(timeBuf, 32, L"%02d:%02d:%02d", ti.tm_hour, ti.tm_min, ti.tm_sec);

    RECT timeRc = { rc.left + 210, rc.top, rc.left + 290, rc.bottom };
    SetTextColor(hdc, COL_TEXT_DIM);
    SelectObject(hdc, g_fontMono);
    DrawTextW(hdc, timeBuf, -1, &timeRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

    // Превью входа
    RECT inRc = { rc.left + 300, rc.top, rc.left + (rc.right - rc.left) / 2, rc.bottom };
    SetTextColor(hdc, COL_TEXT);
    DrawTextW(hdc, e.inputPreview.c_str(), -1, &inRc,
        DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);

    // Стрелка
    RECT arrRc = { rc.left + (rc.right - rc.left) / 2, rc.top,
                  rc.left + (rc.right - rc.left) / 2 + 40, rc.bottom };
    SetTextColor(hdc, COL_TEXT_FAINT);
    DrawTextW(hdc, L"  →  ", -1, &arrRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

    // Превью выхода
    RECT outRc = { rc.left + (rc.right - rc.left) / 2 + 40, rc.top, rc.right - 10, rc.bottom };
    SetTextColor(hdc, COL_WARNING);
    DrawTextW(hdc, e.outputPreview.c_str(), -1, &outRc,
        DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);

    SelectObject(hdc, oldFont);
}

