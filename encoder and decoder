}

void OnClearHistory() {
    g_history.clear();
    RefreshHistoryList();
}

void RefreshHistoryList() {
    if (!g_hHistoryList) return;
    SendMessageW(g_hHistoryList, LB_RESETCONTENT, 0, 0);

    for (size_t i = 0; i < g_history.size(); i++) {
        const auto& e = g_history[i];
        tm ti;
        localtime_s(&ti, &e.time);

        wchar_t buf[256];
        swprintf(buf, 256, L"%s  %s  %02d:%02d:%02d  %s",
            e.isEncode ? L"EN" : L"DE",
            g_modes[e.mode].name,
            ti.tm_hour, ti.tm_min, ti.tm_sec,
            e.inputPreview.c_str());

        SendMessageW(g_hHistoryList, LB_ADDSTRING, 0, (LPARAM)buf);
    }
}

void UpdateInfo() {
    int inLen = GetWindowTextLengthW(g_hEditInput);
    int outLen = GetWindowTextLengthW(g_hEditOutput);

    wstringstream ss;
    ss << L"  Режим: " << g_modes[g_mode].name
        << L"   |   Вход: " << inLen << L" симв."
        << L"   |   Выход: " << outLen << L" симв."
        << L"   |   История: " << g_history.size();

    SetWindowTextW(g_hStaticInfo, ss.str().c_str());
}
